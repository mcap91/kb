{
  "name": "kb",
  "description": "Agent-facing toolkit for structured repo-local wiki, reviewed multi-agent dispatch, and deterministic code-graph extraction",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "wiki": "node --import tsx packages/wiki-cli/src/index.ts",
    "wiki:mcp": "node --import tsx packages/wiki-mcp/src/server.ts",
    "codex:mcp:register": "node --import tsx scripts/register-codex-mcp.ts",
    "dispatch": "node --import tsx packages/dispatch-cli/src/index.ts",
    "dispatch:mcp": "node --import tsx packages/dispatch-mcp/src/server.ts",
    "graph": "node --import tsx packages/graph-explore/src/extract.ts",
    "setup:test-kb": "node scripts/setup-test-kb.mjs",
    "test": "vitest run",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "zod": "^4.4.3"
  }
}
